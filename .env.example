# Leave unset to call the API on the panel's own origin (/api), which is how the panel is
# deployed (its site proxies /api to Turbo) and how `yarn dev` runs (Vite proxies it).
# Set it only when the API is on another origin; the server's Turbo:Admin:PanelUrl must then
# name this panel's origin.
# VITE_API_URL=https://api.example.com
